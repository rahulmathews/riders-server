{
  "name": "riders-server",
  "version": "1.0.0-alpha.18",
  "description": "A comprehensive backend API for a modern ride-sharing platform built with NestJS, GraphQL, and self-hosted Supabase, providing real-time ride matching, location tracking, and seamless payment processing.",
  "main": "dist/main.js",
  "scripts": {
    "preinstall": "node scripts/check-node-version.js",
    "build": "nest build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "commitlint": "commitlint --edit",
    "prepare": "node -e \"if (process.env.CI !== 'true' && process.env.HUSKY !== '0') { require('child_process').execSync('husky', {stdio: 'inherit'}) }\"",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run"
  },
  "dependencies": {
    "@nestjs/apollo": "^13.2.4",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.17",
    "@nestjs/graphql": "^13.2.4",
    "@nestjs/platform-express": "^11.1.17",
    "apollo-server-express": "^3.13.0",
    "graphql": "^16.11.0",
    "joi": "^18.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@nestjs/cli": "^11.0.17",
    "@nestjs/schematics": "^10.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.3",
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.0.0",
    "semantic-release": "^24.2.7",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.1.0",
    "typescript": "5.3.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "nestjs",
    "typescript",
    "ride-sharing",
    "graphql",
    "supabase"
  ],
  "author": "Rahul Mathews",
  "license": "MIT",
  "engines": {
    "node": ">=20.15.0",
    "npm": ">=10.0.0"
  }
}
