# =============================================================================
# MVP Environment Configuration - Minimal Setup
# =============================================================================
# Copy this file to .env.local and update the values for your environment
# Never commit .env files to version control

# =============================================================================
# Application Configuration
# =============================================================================
NODE_ENV=local
PORT=3000
HOST=localhost

# =============================================================================
# Database Configuration (Supabase/PostgreSQL) - REQUIRED
# =============================================================================
DATABASE_URL=postgresql://username:password@localhost:5432/riders_db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# =============================================================================
# Authentication & Security - REQUIRED
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret-key-change-this-in-production
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# =============================================================================
# Development Features (GraphQL & API)
# =============================================================================
DEBUG=true
ENABLE_SWAGGER=true
ENABLE_GRAPHQL_PLAYGROUND=true
LOG_LEVEL=debug

# =============================================================================
# Feature Flags (MVP Core Features)
# =============================================================================
ENABLE_REAL_TIME_TRACKING=true
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_EMAIL_NOTIFICATIONS=false

# =============================================================================
# External Services (Optional for MVP - Add as needed)
# =============================================================================
# Google Maps API (for location services)
GOOGLE_MAPS_API_KEY=

# =============================================================================
# Redis (Optional for MVP - Add when caching is needed)
# =============================================================================
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

# =============================================================================
# Payment Services (Optional for MVP - Add when payments are implemented)
# =============================================================================
# STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
# STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# =============================================================================
# Communication Services (Optional for MVP - Add when notifications are needed)
# =============================================================================
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+1234567890
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_PRIVATE_KEY=your-firebase-private-key
# FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# =============================================================================
# Email Configuration (Optional for MVP - Add when email is needed)
# =============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-email-password
# EMAIL_FROM=noreply@riders-app.com

# =============================================================================
# File Upload (Optional for MVP - Add when file uploads are needed)
# =============================================================================
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=riders-app-uploads

# =============================================================================
# Rate Limiting (Optional for MVP - Add when rate limiting is needed)
# =============================================================================
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# Monitoring (Optional for MVP - Add when monitoring is needed)
# =============================================================================
# SENTRY_DSN=your-sentry-dsn
# NEW_RELIC_LICENSE_KEY=your-new-relic-license-key

